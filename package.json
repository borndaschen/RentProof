{
  "name": "rentproof",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "dev:lan": "node scripts/run-next.mjs dev --lan",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "start:lan": "node scripts/run-next.mjs start --lan",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:check": "node scripts/security-gate.mjs",
    "env:check": "node scripts/check-toolchain.mjs",
    "demo:check": "node scripts/demo-readiness.mts",
    "lan:firewall:install-disabled": "node scripts/lan-firewall.mts InstallDisabled",
    "lan:firewall:enable": "node scripts/lan-firewall.mts Enable",
    "lan:firewall:disable": "node scripts/lan-firewall.mts Disable",
    "lan:firewall:verify": "node scripts/lan-firewall.mts Verify",
    "eval:live": "node scripts/openai-live-smoke.mjs",
    "db:migrate": "node scripts/postgres-migrate.mts",
    "db:check": "node scripts/postgres-readiness.mts",
    "db:listener:check": "node scripts/postgres-listener-check.mts",
    "db:smoke": "node scripts/postgres-synthetic-smoke.mts",
    "db:demo": "pwsh -NoProfile -File scripts/windows/Manage-RentProofPostgresDemo.ps1 -Action",
    "auth:demo": "pwsh -NoProfile -File scripts/windows/Manage-RentProofPostgresDemo.ps1 -Action"
  },
  "dependencies": {
    "@next/env": "16.3.4",
    "@radix-ui/react-tabs": "1.1.21",
    "argon2": "0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "kysely": "0.29.5",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "openai": "7.9.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.5.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.13",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "postcss": "8.5.6",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0"
  }
}
