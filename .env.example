# Server-only OpenAI credential. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Deployment boundary. Local development uses loopback HTTP. LAN access is only
# available through the separately configured lan_secure_demo HTTPS profile.
RENTPROOF_DEPLOYMENT_PROFILE=local_development

# Local development listener. Do not replace this with a LAN or wildcard address.
RENTPROOF_BIND_HOST=127.0.0.1
RENTPROOF_PORT=3000
RENTPROOF_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Exact host/origin allowlists. No wildcard values.
RENTPROOF_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
RENTPROOF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local development remains sample-data-only.
RENTPROOF_ALLOW_REAL_DATA=false

# Authentication is disabled by default. `self_hosted` is accepted on exact
# loopback development or the separate HTTPS LAN profile with PostgreSQL.
RENTPROOF_AUTH_MODE=synthetic
RENTPROOF_RULE_PROFILE=p0
# 32 random bytes encoded as base64url. Server-only; generate outside source
# control and keep blank while auth is disabled.
RENTPROOF_AUTH_TOKEN_KEY=

# Explicit mode: fixture never calls OpenAI; live requires a valid key.
RENTPROOF_LLM_MODE=fixture

# One-shot CLI-only opt-in for `pnpm eval:live -- --live`. Keep disabled for
# normal app execution and CI; the smoke command sends two minimal synthetic requests.
RENTPROOF_LIVE_SMOKE=0

# Operator assertion only. Keep false until the Development Project hard limit,
# alerts, and model rate limits have been verified in the OpenAI Dashboard.
OPENAI_PROJECT_LIMITS_CONFIRMED=false

# Fixed model routing. Requests cannot override these values.
OPENAI_CONVERSATION_MODEL=gpt-5.6-luna
OPENAI_CONVERSATION_REASONING_EFFORT=low
OPENAI_EVIDENCE_MODEL=gpt-5.6-terra
OPENAI_EVIDENCE_REASONING_EFFORT=medium
OPENAI_SERVICE_TIER=default

# Demo and runtime data stay outside the RentProof repository.
RENTPROOF_DEMO_DIR=
RENTPROOF_DEMO_CASE_VERSION=golden-v1
RENTPROOF_RUNTIME_DIR=

# HTTPS LAN settings belong in ignored `.env.secure-lan.local`, never in source
# control. That file uses `lan_secure_demo`, an exact RFC1918 address, port 3443,
# internal loopback port 3100, an https:// origin, real-data=true, self_hosted
# auth, PostgreSQL secure_demo, and certificate paths under LocalAppData.
RENTPROOF_INTERNAL_PORT=
RENTPROOF_TLS_CERT_PATH=
RENTPROOF_TLS_KEY_PATH=
RENTPROOF_TLS_CA_PATH=

# Optional PostgreSQL adapter. Local development accepts only sample data in a
# loopback `rentproof_demo` database. HTTPS LAN uses a separate loopback-only
# `rentproof_secure_demo` database; never expose the PostgreSQL port to LAN.
RENTPROOF_DATABASE_ADAPTER=disabled
RENTPROOF_DATABASE_URL=
RENTPROOF_DATABASE_ROLE=app
RENTPROOF_DATABASE_ENVIRONMENT=synthetic_demo
RENTPROOF_DATABASE_MAX_CONNECTIONS=4
